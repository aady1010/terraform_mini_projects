{
  "family": "node-api-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::104760031249:role/ecs-execution-role",
  "containerDefinitions": [
    {
      "name": "node-api-container",
      "image": "104760031249.dkr.ecr.us-east-1.amazonaws.com/devops-node-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ]
    }
  ]
}
